{
  "info": {
    "name": "LMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "courseId",
      "value": "1"
    },
    {
      "key": "lessonId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Login - Student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@lms.local\",\n  \"password\": \"Student@123\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "List Courses",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/courses"
      }
    },
    {
      "name": "Enroll in Course",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/enrollments/courses/{{courseId}}"
      }
    },
    {
      "name": "List Lessons",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/courses/{{courseId}}/lessons"
      }
    },
    {
      "name": "Mark Lesson Complete",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/progress/lessons/{{lessonId}}/complete"
      }
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/health",
          "protocol": "http",
          "host": [
            "localhost:8080"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "My Profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/me",
          "protocol": "http",
          "host": [
            "localhost:8080"
          ],
          "path": [
            "api",
            "me"
          ]
        }
      }
    }
  ]
}